/* =============================================================
   TYPOGRAPHY â€” Portfolio Design System
   Font: Geist (sans) + Geist Mono  |  Source: Figma
   ============================================================= */

/*
  HTML <head> import:
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap" rel="stylesheet">
*/

:root {

  /* -----------------------------------------------------------
     FONT FAMILIES
  ----------------------------------------------------------- */
  --font-sans:  'Geist', ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-mono:  'Geist Mono', ui-monospace, 'Cascadia Code', 'Fira Code', monospace;

  /* -----------------------------------------------------------
     FONT WEIGHTS  (from Figma font-weight variables)
  ----------------------------------------------------------- */
  --fw-thin:       100;
  --fw-extralight: 200;
  --fw-light:      300;
  --fw-normal:     400;   /* Regular */
  --fw-medium:     500;
  --fw-semibold:   600;
  --fw-bold:       700;
  --fw-extrabold:  800;
  --fw-black:      900;

  /* -----------------------------------------------------------
     TYPE SCALE  (from Figma text/* variables)
     Format: font-size / line-height
  ----------------------------------------------------------- */
  --text-xs:    0.75rem;    /* 12px  / 16px */
  --text-sm:    0.875rem;   /* 14px  / 20px */
  --text-base:  1rem;       /* 16px  / 24px */
  --text-lg:    1.125rem;   /* 18px  / 28px */
  --text-xl:    1.25rem;    /* 20px  / 28px */
  --text-2xl:   1.5rem;     /* 24px  / 32px */
  --text-3xl:   1.875rem;   /* 30px  / 36px */
  --text-4xl:   2.25rem;    /* 36px  / 40px */
  --text-5xl:   3rem;       /* 48px  / 48px */
  --text-6xl:   3.75rem;    /* 60px  / 60px */
  --text-7xl:   4.5rem;     /* 72px  / 72px */
  --text-8xl:   6rem;       /* 96px  / 96px */
  --text-9xl:   8rem;       /* 128px / 128px */

  --lh-xs:      1rem;       /* 16px */
  --lh-sm:      1.25rem;    /* 20px */
  --lh-base:    1.5rem;     /* 24px */
  --lh-lg:      1.75rem;    /* 28px */
  --lh-xl:      1.75rem;    /* 28px */
  --lh-2xl:     2rem;       /* 32px */
  --lh-3xl:     2.25rem;    /* 36px */
  --lh-4xl:     2.5rem;     /* 40px */
  --lh-5xl:     3rem;       /* 48px */
  --lh-6xl:     3.75rem;    /* 60px */
  --lh-7xl:     4.5rem;     /* 72px */

  /* -----------------------------------------------------------
     SEMANTIC TYPE ROLES  (named by usage in portfolio)
  ----------------------------------------------------------- */

  /* Display / Hero â€” Homepage headline */
  --type-display-size:    var(--text-5xl);    /* 48px */
  --type-display-weight:  var(--fw-extrabold);
  --type-display-lh:      var(--lh-5xl);

  /* H1 â€” Page titles */
  --type-h1-size:         var(--text-4xl);    /* 36px */
  --type-h1-weight:       var(--fw-extrabold);
  --type-h1-lh:           var(--lh-4xl);

  /* H2 â€” Section headings */
  --type-h2-size:         var(--text-3xl);    /* 30px */
  --type-h2-weight:       var(--fw-semibold);
  --type-h2-lh:           var(--lh-3xl);

  /* H3 â€” Sub-sections */
  --type-h3-size:         var(--text-2xl);    /* 24px */
  --type-h3-weight:       var(--fw-semibold);
  --type-h3-lh:           var(--lh-2xl);

  /* H4 â€” Card titles, sidebar sections */
  --type-h4-size:         var(--text-xl);     /* 20px */
  --type-h4-weight:       var(--fw-semibold);
  --type-h4-lh:           var(--lh-xl);

  /* Lead â€” Intro paragraph / tagline */
  --type-lead-size:       var(--text-lg);     /* 18px */
  --type-lead-weight:     var(--fw-semibold);
  --type-lead-lh:         var(--lh-lg);

  /* Body â€” Default paragraph text */
  --type-body-size:       var(--text-base);   /* 16px */
  --type-body-weight:     var(--fw-normal);
  --type-body-lh:         var(--lh-base);

  /* Body Bold â€” Emphasis inline */
  --type-body-bold-weight: var(--fw-bold);

  /* Small â€” Meta, labels, tags */
  --type-small-size:      var(--text-sm);     /* 14px */
  --type-small-weight:    var(--fw-medium);
  --type-small-lh:        var(--lh-sm);

  /* Caption / XS â€” Timestamps, footnotes */
  --type-xs-size:         var(--text-xs);     /* 12px */
  --type-xs-weight:       var(--fw-light);
  --type-xs-lh:           var(--lh-xs);
  --type-xs-font:         var(--font-mono);   /* Uses mono per Figma */

  /* Code â€” Inline code snippets */
  --type-code-size:       var(--text-sm);     /* 14px */
  --type-code-weight:     var(--fw-normal);
  --type-code-lh:         var(--lh-sm);
  --type-code-font:       var(--font-mono);

}

/* =============================================================
   BASE HTML TYPOGRAPHY
   ============================================================= */

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body {
  font-family: var(--font-sans);
  font-size: var(--type-body-size);
  font-weight: var(--type-body-weight);
  line-height: var(--type-body-lh);
  color: var(--color-fg-primary);
}

h1, .h1 {
  font-family: var(--font-sans);
  font-size: var(--type-h1-size);
  font-weight: var(--type-h1-weight);
  line-height: var(--type-h1-lh);
  letter-spacing: -0.02em;
  color: var(--color-fg-primary);
}

h2, .h2 {
  font-family: var(--font-sans);
  font-size: var(--type-h2-size);
  font-weight: var(--type-h2-weight);
  line-height: var(--type-h2-lh);
  letter-spacing: -0.015em;
  color: var(--color-fg-primary);
}

h3, .h3 {
  font-family: var(--font-sans);
  font-size: var(--type-h3-size);
  font-weight: var(--type-h3-weight);
  line-height: var(--type-h3-lh);
  letter-spacing: -0.01em;
  color: var(--color-fg-primary);
}

h4, .h4 {
  font-family: var(--font-sans);
  font-size: var(--type-h4-size);
  font-weight: var(--type-h4-weight);
  line-height: var(--type-h4-lh);
  color: var(--color-fg-primary);
}

p {
  font-size: var(--type-body-size);
  line-height: var(--type-body-lh);
  color: var(--color-fg-secondary);
}

.lead {
  font-size: var(--type-lead-size);
  font-weight: var(--type-lead-weight);
  line-height: var(--type-lead-lh);
  color: var(--color-fg-secondary);
}

small, .text-sm {
  font-size: var(--type-small-size);
  font-weight: var(--type-small-weight);
  line-height: var(--type-small-lh);
}

.text-xs {
  font-family: var(--type-xs-font);
  font-size: var(--type-xs-size);
  font-weight: var(--type-xs-weight);
  line-height: var(--type-xs-lh);
  color: var(--color-fg-tertiary);
}

code, .code {
  font-family: var(--type-code-font);
  font-size: var(--type-code-size);
  line-height: var(--type-code-lh);
}

a {
  color: var(--color-accent);
  text-decoration: none;
  transition: color 0.15s ease;
}
a:hover { color: var(--color-accent-hover); }

strong, b { font-weight: var(--fw-bold); }
em, i     { font-style: italic; }
