/* Token layers â€” import in this order */
@import './colors.css';
@import './typography.css';
@import './spacing.css';
@import './effects.css';

/* =============================================================
   GLOBAL RESET
   ============================================================= */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 80px; /* offset for fixed nav */
}

img, video, svg {
  display: block;
  max-width: 100%;
}

button {
  font-family: inherit;
  cursor: pointer;
}

input, textarea, select {
  font-family: inherit;
  font-size: inherit;
}

/* =============================================================
   COMPONENT TOKENS â€” ready-to-use primitives
   ============================================================= */

/* BUTTON ---------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  padding: var(--sp-2-5) var(--sp-4);
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  font-weight: var(--fw-medium);
  line-height: 1;
  border-radius: var(--radius-btn);
  border: 1px solid transparent;
  cursor: pointer;
  transition: all var(--transition-base);
  white-space: nowrap;
  text-decoration: none;
}
.btn:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}
.btn:disabled {
  opacity: var(--opacity-disabled);
  pointer-events: none;
}

/* Variants */
.btn-default {
  background: var(--color-fg-primary);
  color: #FFFFFF;
  border-color: var(--color-fg-primary);
}
.btn-default:hover { background: #3a3740; border-color: #3a3740; }

.btn-accent {
  background: var(--color-accent);
  color: var(--color-fg-on-accent);
  border-color: var(--color-accent);
}
.btn-accent:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); }

.btn-outline {
  background: transparent;
  color: var(--color-fg-primary);
  border-color: var(--color-border);
}
.btn-outline:hover { background: var(--color-bg-secondary); }

.btn-ghost {
  background: transparent;
  color: var(--color-fg-primary);
  border-color: transparent;
}
.btn-ghost:hover { background: var(--color-bg-secondary); }

.btn-secondary {
  background: var(--color-bg-secondary);
  color: var(--color-fg-primary);
  border-color: var(--color-bg-secondary);
}
.btn-secondary:hover { background: var(--color-border); }

.btn-destructive {
  background: var(--color-destructive);
  color: var(--color-destructive-fg);
  border-color: var(--color-destructive);
}

/* Sizes */
.btn-xs   { padding: var(--sp-1-5) var(--sp-2-5); font-size: var(--text-xs); border-radius: var(--radius-sm); }
.btn-sm   { padding: var(--sp-2)   var(--sp-3); font-size: var(--text-xs); }
.btn-lg   { padding: var(--sp-3)   var(--sp-6); font-size: var(--text-base); }
.btn-icon { padding: var(--sp-2-5); aspect-ratio: 1; }

/* CARD ------------------------------------------------------- */
.card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card);
  padding: var(--sp-6);
}
.card-sm {
  border-radius: var(--radius-xl);
  padding: var(--sp-4);
}
.card-elevated {
  box-shadow: var(--shadow-card);
  border-color: transparent;
}

/* BADGE ------------------------------------------------------ */
.badge {
  display: inline-flex;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-0-5) var(--sp-2-5);
  font-size: var(--text-xs);
  font-weight: var(--fw-medium);
  line-height: 1.4;
  border-radius: var(--radius-full);
  border: 1px solid transparent;
  white-space: nowrap;
}
.badge-default    { background: var(--color-fg-primary);    color: #FFF; }
.badge-secondary  { background: var(--color-bg-secondary);  color: var(--color-fg-primary); border-color: var(--color-border); }
.badge-outline    { background: transparent; color: var(--color-fg-primary); border-color: var(--color-border); }
.badge-accent     { background: var(--color-accent-subtle); color: var(--color-accent); }
.badge-destructive { background: var(--color-destructive-subtle); color: var(--color-destructive); }
.badge-ghost      { background: transparent; color: var(--color-fg-secondary); }

/* INPUT ----------------------------------------------------- */
.input {
  display: flex;
  width: 100%;
  padding: var(--sp-2) var(--sp-3);
  font-family: var(--font-sans);
  font-size: var(--text-sm);
  line-height: var(--lh-sm);
  color: var(--color-fg-primary);
  background: var(--color-bg-light);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-input);
  outline: none;
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}
.input::placeholder { color: var(--color-fg-tertiary); }
.input:focus {
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px var(--color-accent-subtle);
}
.input:disabled {
  background: var(--color-bg-secondary);
  color: var(--color-fg-tertiary);
  opacity: var(--opacity-disabled);
}
.input.invalid {
  border-color: var(--color-destructive);
  box-shadow: 0 0 0 3px var(--color-destructive-subtle);
}

/* SEPARATOR ------------------------------------------------- */
.separator {
  background: var(--color-border-subtle);
  flex-shrink: 0;
}
.separator-h { height: 1px; width: 100%; }
.separator-v { width: 1px;  height: 100%; }

/* SKELETON -------------------------------------------------- */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--color-bg-secondary) 25%,
    var(--color-border-subtle) 50%,
    var(--color-bg-secondary) 75%
  );
  background-size: 200% 100%;
  border-radius: var(--radius-sm);
  animation: skeleton-shimmer 1.5s infinite;
}
@keyframes skeleton-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* SPINNER --------------------------------------------------- */
.spinner {
  border: 2px solid var(--color-border);
  border-top-color: var(--color-accent);
  border-radius: var(--radius-full);
  animation: spin 0.7s linear infinite;
}
.spinner-sm  { width: 12px; height: 12px; }      /* size 3 */
.spinner-md  { width: 16px; height: 16px; }      /* size 4 */
.spinner-base { width: 20px; height: 20px; }     /* size 5 */
.spinner-lg  { width: 24px; height: 24px; }      /* size 6 */
.spinner-xl  { width: 32px; height: 32px; }      /* size 8 */
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* TOOLTIP --------------------------------------------------- */
.tooltip {
  position: absolute;
  padding: var(--sp-1-5) var(--sp-2-5);
  background: var(--color-fg-primary);
  color: #FFFFFF;
  font-size: var(--text-xs);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-tooltip);
  white-space: nowrap;
  pointer-events: none;
  z-index: 100;
}

/* KBD ------------------------------------------------------- */
kbd, .kbd {
  display: inline-flex;
  align-items: center;
  padding: var(--sp-0-5) var(--sp-1-5);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--fw-medium);
  background: var(--color-bg-secondary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-2xs);
}

/* AVATAR ---------------------------------------------------- */
.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  background: var(--color-bg-secondary);
  color: var(--color-fg-secondary);
  font-weight: var(--fw-semibold);
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-xs     { width: 24px;  height: 24px;  font-size: var(--text-xs); }
.avatar-sm     { width: 32px;  height: 32px;  font-size: var(--text-sm); }
.avatar-md     { width: 40px;  height: 40px;  font-size: var(--text-base); }
.avatar-lg     { width: 48px;  height: 48px;  font-size: var(--text-lg); }
.avatar-xl     { width: 64px;  height: 64px;  font-size: var(--text-xl); }
.avatar img    { width: 100%; height: 100%; object-fit: cover; }
