  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:           #F2F2F7;
      --bg-secondary: #EAEAF0;
      --bg-light:     #FBFCFE;
      --fg:           #242225;
      --fg-2:         #68616B;
      --fg-3:         #AAAAB8;
      --accent:       #F34775;
      --accent-hover: #D93364;
      --accent-sub:   #FDE8EE;
      --border:       #D3D3D9;
      --border-sub:   #E8E8EF;
      --font:         'Geist', sans-serif;
      --mono:         'Geist Mono', monospace;
      --ease:         cubic-bezier(0.16, 1, 0.3, 1);
      --ease-out:     cubic-bezier(0.0, 0, 0.2, 1);
    }

    html { font-size: 16px; scroll-behavior: smooth; scroll-padding-top: 80px; }
    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--fg);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }
    img { display: block; max-width: 100%; }
    a { text-decoration: none; color: inherit; }

    /* ════════════════════════════════
       NAV
    ════════════════════════════════ */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      padding: 22px 52px;
      display: flex; align-items: center; justify-content: space-between;
      transition: background 0.4s, backdrop-filter 0.4s, border-color 0.4s;
      border-bottom: 1px solid transparent;
    }
    nav.scrolled {
      background: rgba(242,242,247,0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom-color: var(--border-sub);
    }
    .nav-logo {
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--fg);
    }
    .nav-links { display: flex; gap: 36px; list-style: none; }
    .nav-links a {
      font-size: 13px;
      font-weight: 500;
      color: var(--fg-2);
      letter-spacing: 0.01em;
      transition: color 0.15s;
    }
    .nav-links a:hover { color: var(--fg); }
    .nav-cta {
      font-size: 13px;
      font-weight: 500;
      padding: 9px 22px;
      border: 1px solid var(--border);
      border-radius: 40px;
      color: var(--fg);
      transition: background 0.15s, border-color 0.15s, transform 0.15s;
    }
    .nav-cta:hover { background: var(--bg-secondary); border-color: var(--fg-3); transform: translateY(-1px); }

    /* ════════════════════════════════
       HERO
    ════════════════════════════════ */
    .hero {
      min-height: 100vh;
      padding: 130px 52px 100px;
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: 1fr auto;
      align-items: end;
      gap: 0 48px;
      position: relative;
    }
    .hero-text { align-self: end; }
    .hero-eyebrow {
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-bottom: 28px;
      display: flex; align-items: center; gap: 10px;
      opacity: 0;
      animation: fadeUp 0.6s var(--ease) 0.05s forwards;
    }
    .hero-eyebrow::before {
      content: '';
      display: inline-block;
      width: 20px; height: 1px;
      background: var(--accent);
    }
    .hero-headline {
      font-size: clamp(60px, 9.5vw, 128px);
      font-weight: 800;
      line-height: 0.91;
      letter-spacing: -0.03em;
      color: var(--fg);
    }
    .hero-headline .line { display: block; overflow: hidden; }
    .hero-headline .line span {
      display: inline-block;
      opacity: 0;
      transform: translateY(100%);
    }
    .hero-headline .line:nth-child(1) span { animation: slideUp 0.7s var(--ease) 0.15s forwards; }
    .hero-headline .line:nth-child(2) span { animation: slideUp 0.7s var(--ease) 0.25s forwards; }
    .hero-headline .line:nth-child(3) span { animation: slideUp 0.7s var(--ease) 0.35s forwards; }
    .hero-headline em { font-style: normal; color: var(--accent); }
    .hero-sub {
      margin-top: 36px;
      font-size: 17px;
      line-height: 1.65;
      color: var(--fg-2);
      max-width: 400px;
      opacity: 0;
      animation: fadeUp 0.6s var(--ease) 0.5s forwards;
    }
    .hero-actions {
      margin-top: 44px;
      display: flex; gap: 12px; flex-wrap: wrap;
      opacity: 0;
      animation: fadeUp 0.6s var(--ease) 0.6s forwards;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 30px;
      background: var(--fg);
      color: #fff;
      font-family: var(--font);
      font-size: 14px;
      font-weight: 500;
      border-radius: 40px;
      transition: background 0.15s, transform 0.2s var(--ease);
    }
    .btn-primary:hover { background: #3a3740; transform: translateY(-2px); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 13px 30px;
      border: 1px solid var(--border);
      color: var(--fg);
      font-family: var(--font);
      font-size: 14px;
      font-weight: 500;
      border-radius: 40px;
      transition: background 0.15s, border-color 0.15s, transform 0.2s var(--ease);
    }
    .btn-secondary:hover { background: var(--bg-secondary); border-color: var(--fg-3); transform: translateY(-2px); }

    .hero-figure {
      align-self: end;
      width: clamp(160px, 20vw, 320px);
      opacity: 0;
      animation: fadeIn 1s var(--ease) 0.3s forwards;
    }
    .hero-figure img {
      width: 100%;
      border-radius: 20px;
      object-fit: cover;
      object-position: top;
    }

    .hero-scroll {
      grid-column: 1 / -1;
      display: flex; align-items: center; gap: 10px;
      margin-top: 64px;
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--fg-3);
      opacity: 0;
      animation: fadeIn 1s var(--ease) 1.1s forwards;
    }
    .scroll-line {
      width: 40px; height: 1px;
      background: var(--border);
      position: relative; overflow: hidden;
    }
    .scroll-line::after {
      content: '';
      position: absolute; top: 0; left: -100%;
      width: 100%; height: 100%;
      background: var(--accent);
      animation: scanline 2s ease-in-out 1.5s infinite;
    }

    /* ════════════════════════════════
       WORK SECTION
    ════════════════════════════════ */
    .section-work { padding: 80px 52px 120px; }

    .section-label {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--fg-3);
      margin-bottom: 48px;
      display: flex; align-items: center; gap: 14px;
    }
    .section-label::after {
      content: '';
      flex: 1; height: 1px;
      background: var(--border-sub);
    }

    /* ── Work items: full-width rows ── */
    .work-list { display: flex; flex-direction: column; }

    .work-item {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
      padding: 52px 0;
      border-top: 1px solid var(--border-sub);
      color: inherit;
      position: relative;
      cursor: pointer;
    }
    .work-item:last-child { border-bottom: 1px solid var(--border-sub); }

    /* alternate: image left on even items */
    .work-item:nth-child(even) .work-item-meta { order: 2; }
    .work-item:nth-child(even) .work-item-visual { order: 1; }

    .work-item:hover .work-item-img { transform: scale(1.04); }
    .work-item:hover .work-cta-arrow { transform: translate(4px, -4px); }

    .work-item-meta {
      display: flex; flex-direction: column; gap: 18px;
    }
    .work-tags { display: flex; gap: 6px; flex-wrap: wrap; }
    .tag {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 4px 11px;
      border-radius: 20px;
      border: 1px solid var(--border);
      color: var(--fg-3);
      background: transparent;
    }
    .work-number {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--fg-3);
      letter-spacing: 0.06em;
    }
    .work-title {
      font-size: clamp(28px, 3.5vw, 52px);
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 0.95;
      color: var(--fg);
    }
    .work-desc {
      font-size: 15px;
      line-height: 1.65;
      color: var(--fg-2);
      max-width: 360px;
    }
    .work-cta {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 13px;
      font-weight: 600;
      color: var(--fg);
      margin-top: 4px;
      letter-spacing: 0.01em;
    }
    .work-cta-arrow {
      font-size: 16px;
      transition: transform 0.25s var(--ease);
    }

    .work-item-visual {
      border-radius: 18px;
      overflow: hidden;
      background: var(--bg-secondary);
      aspect-ratio: 16 / 10;
      position: relative;
    }
    .work-item-img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.6s var(--ease);
      display: block;
    }

    /* ════════════════════════════════
       ABOUT SECTION
    ════════════════════════════════ */
    .section-about {
      padding: 80px 52px 120px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: start;
    }
    .about-content {}
    .about-body {
      margin-top: 40px;
      display: flex; flex-direction: column; gap: 20px;
    }
    .about-body p {
      font-size: 16px;
      line-height: 1.78;
      color: var(--fg-2);
    }
    .about-cv {
      margin-top: 40px;
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 14px;
      font-weight: 600;
      color: var(--fg);
      padding-bottom: 3px;
      border-bottom: 2px solid var(--fg);
      transition: gap 0.2s var(--ease), color 0.15s;
    }
    .about-cv:hover { gap: 14px; color: var(--accent); border-bottom-color: var(--accent); }

    /* photo grid */
    .about-gallery {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
      gap: 10px;
    }
    .gallery-photo {
      border-radius: 14px;
      overflow: hidden;
      background: var(--bg-secondary);
    }
    .gallery-photo img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform 0.5s var(--ease);
      display: block;
    }
    .gallery-photo:hover img { transform: scale(1.05); }

    /* layout: first photo spans full width as landscape header */
    .gallery-photo:nth-child(1) {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 2.2;
    }
    /* remaining photos: portrait */
    .gallery-photo:nth-child(n+2) { aspect-ratio: 3 / 4; }

    /* ════════════════════════════════
       FOOTER
    ════════════════════════════════ */
    footer {
      padding: 100px 52px 60px;
      border-top: 1px solid var(--border-sub);
    }
    .footer-headline {
      font-size: clamp(44px, 7.5vw, 108px);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 0.94;
      color: var(--fg);
      margin-bottom: 72px;
    }
    .footer-headline em { font-style: normal; color: var(--accent); }

    .footer-bottom {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 40px;
      flex-wrap: wrap;
    }
    .footer-back {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--fg-3);
      padding: 10px 18px;
      border: 1px solid var(--border-sub);
      border-radius: 40px;
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .footer-back:hover { color: var(--fg); border-color: var(--border); background: var(--bg-secondary); }

    .footer-connect { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }
    .footer-connect-label {
      font-family: var(--mono);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--fg-3);
    }
    .footer-links { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .footer-link {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 13px;
      font-weight: 500;
      padding: 9px 18px;
      border: 1px solid var(--border);
      border-radius: 40px;
      color: var(--fg-2);
      background: var(--bg-light);
      transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s var(--ease);
    }
    .footer-link:hover {
      background: var(--fg);
      color: #fff;
      border-color: var(--fg);
      transform: translateY(-2px);
    }
    .footer-copy {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--fg-3);
      letter-spacing: 0.05em;
      margin-top: 56px;
      padding-top: 24px;
      border-top: 1px solid var(--border-sub);
    }

    /* ════════════════════════════════
       ANIMATIONS
    ════════════════════════════════ */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(100%); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes scanline {
      0%   { left: -100%; }
      50%  { left: 0%; }
      100% { left: 100%; }
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%       { opacity: 0.4; transform: scale(1.6); }
    }

    /* scroll reveal */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.75s var(--ease), transform 0.75s var(--ease);
    }
    .reveal.in { opacity: 1; transform: none; }
    .reveal-d1 { transition-delay: 0.08s; }
    .reveal-d2 { transition-delay: 0.16s; }
    .reveal-d3 { transition-delay: 0.24s; }

    /* ════════════════════════════════
       RESPONSIVE
    ════════════════════════════════ */
    @media (max-width: 1100px) {
      nav { padding: 18px 32px; }
      .hero { padding: 110px 32px 80px; gap: 32px; }
      .section-work, footer { padding-left: 32px; padding-right: 32px; }
      .section-about { padding: 60px 32px 100px; }
    }
    @media (max-width: 768px) {
      nav { padding: 16px 20px; }
      .nav-links { display: none; }
      .hero {
        padding: 100px 20px 60px;
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .hero-figure { width: 140px; order: -1; }
      .hero-headline { font-size: clamp(46px, 13vw, 72px); }
      .hero-scroll { margin-top: 40px; }
      .section-work { padding: 48px 20px 60px; }
      .work-item {
        grid-template-columns: 1fr;
        gap: 28px;
        padding: 40px 0;
      }
      .work-item:nth-child(even) .work-item-meta { order: unset; }
      .work-item:nth-child(even) .work-item-visual { order: unset; }
      .section-about { padding: 48px 20px 60px; grid-template-columns: 1fr; gap: 40px; }
      footer { padding: 60px 20px 48px; }
      .footer-bottom { flex-direction: column; }
      .footer-connect { align-items: flex-start; }
      .footer-links { justify-content: flex-start; }
    }
  </style>
</head>
